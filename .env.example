# Database (Neon PostgreSQL)
# Use the pooled connection string (host contains '-pooler') for serverless environments
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech:5432/database?sslmode=require

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=bucket-name
R2_PUBLIC_URL=https://your-domain.com/media

# Authentication (NextAuth v5 beta)
AUTH_SECRET=generated-secret-key-min-32-bytes
AUTH_URL=https://anurag.studio
AUTH_TRUST_HOST=true

# Email service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=bcrypt-hashed-password

# Content revalidation
REVALIDATE_SECRET=your-secret-key-for-revalidation

# Development (optional)
CV_BASE_URL=http://localhost:3000
NODE_ENV=development
